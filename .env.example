# Required in production. Website booking submissions are forwarded here.
AIOFFICE_BOOKING_API_URL=https://staging.easygospa.com/api/bookings/public-request
# Required in production. Public service and therapist catalog is read here.
AIOFFICE_BOOKING_CATALOG_API_URL=https://staging.easygospa.com/api/public/booking-catalog
# Required in production. Public booking tracking reads status here.
AIOFFICE_BOOKING_STATUS_API_URL=https://staging.easygospa.com/api/public/booking-status
AIOFFICE_BOOKING_CANCEL_API_URL=https://staging.easygospa.com/api/public/booking-cancel
# Required in production. Signed-in customers read their bookings here.
AIOFFICE_MY_BOOKINGS_API_URL=https://staging.easygospa.com/api/public/my-bookings
